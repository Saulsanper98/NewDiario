# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# user-uploaded media
/uploads/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-prod.log
next-prod.err.log
next-build.log
next-start.log
next-start.out.log
next-start.err.log
.next-runtime.log
.next-runtime.log.err
.cookies-test.txt

# backups locales (snapshot manual de archivos antes de refactor)
*.backup
*.bak
/backups/

# bundles y logs temporales de trabajo local
tmp-*.log
tmp-*.txt

# vídeos de fondo (pesados, se despliegan aparte; ver public/videos/README.md)
/public/videos/*.mp4
/public/videos/*.webm
/public/videos/*-poster.jpg
/public/videos/*-poster.png

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

.test-cookies.txt

# Uploads privados (fuera de /public, servidos via API autorizada)
uploads-private/

