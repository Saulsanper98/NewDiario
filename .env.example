# Copia a .env y rellena los valores.
# Secreto para sesiones JWT (Auth.js). Mínimo ~32 caracteres; genera uno con:
#   openssl rand -base64 32
# (AUTH_SECRET es el nombre preferido en Auth.js v5; NEXTAUTH_SECRET sigue admitido.)
# Recomendado: mismo valor en AUTH_SECRET y NEXTAUTH_SECRET para evitar desajustes entre Edge y Node.
AUTH_SECRET=
NEXTAUTH_SECRET=

# URL pública de la app (login/callbacks). En local suele ser http://localhost:3000 o el puerto que use Next.
NEXTAUTH_URL=http://localhost:3000

# Auth.js: en despliegue con IP/host propio (p. ej. WinSW) conviene true; el middleware Edge también lo toma de next.config env.
AUTH_TRUST_HOST=true

# PostgreSQL — elige UNA de estas formas según tu entorno:
#
# Instalación nativa en Windows (recomendado si no usas Docker): puerto 5432 por defecto.
# DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@127.0.0.1:5432/NOMBRE_BD
#
# Opcional — Docker Compose del repo (Postgres expuesto en 5433 para no chocar con un 5432 local):
# DATABASE_URL=postgresql://ccops:ccops_password@127.0.0.1:5433/ccops_db
DATABASE_URL=postgresql://ccops:ccops_password@127.0.0.1:5432/ccops_db

# Email del único usuario que ve el panel /bugs (gestión de reportes). Por defecto: saul@movilidadgc.org
# BUG_REPORTS_ADMIN_EMAIL=saul@movilidadgc.org
# PLATFORM_OWNER_EMAIL=saul@movilidadgc.org

# Opcional: inicio de sesión con Microsoft Entra ID
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
