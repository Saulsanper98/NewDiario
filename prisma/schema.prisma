// ─── Novedades / Release notes ────────────────────────────────────────────────

/**
 * Una "novedad" en el changelog visible para todos los usuarios autenticados.
 * Solo el propietario (saul@movilidadgc.org) puede crearlas, editarlas o
 * borrarlas. El resto las marca como leídas para limpiar el badge "NEW".
 */
model ReleaseNote {
  id          String              @id @default(cuid())
  title       String              @db.VarChar(200)
  /** Etiqueta corta de versión / fecha. Opcional. Ej. "v1.2", "25 may". */
  version     String?             @db.VarChar(60)
  /** Resumen muy breve (subtítulo). */
  summary     String?             @db.VarChar(400)
  /** HTML sanitizado del cuerpo (puede incluir listas, imágenes, etc.). */
  body        String              @db.Text
  category    ReleaseNoteCategory @default(FEATURE)
  /** Imagen destacada opcional (URL servida por la app o data URL pequeña). */
  coverImage  String?             @db.VarChar(2048)
  /** Si true, se ancla arriba del listado. */
  pinned      Boolean             @default(false)
  /** Si true, aún no se publica al resto (solo lo ve el propietario). */
  isDraft     Boolean             @default(false)
  publishedAt DateTime            @default(now())
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  createdBy User              @relation("ReleaseNoteAuthor", fields: [createdById], references: [id])
  reads     ReleaseNoteRead[]

  @@index([publishedAt])
  @@index([category])
  @@index([deletedAt])
  @@index([pinned, publishedAt])
  @@index([isDraft])
}

/** Marca cuándo cada usuario leyó una novedad concreta. */
model ReleaseNoteRead {
  id            String   @id @default(cuid())
  releaseNoteId String
  userId        String
  readAt        DateTime @default(now())

  releaseNote ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([releaseNoteId, userId])
  @@index([userId])
}

/**
 * Aviso "broadcast" que se muestra como banner pegado arriba para TODOS los
 * usuarios autenticados. Lo crea exclusivamente el propietario. Permite
 * comunicar reinicios, mantenimientos, alertas, etc.
 */
model Announcement {
  id          String               @id @default(cuid())
  title       String               @db.VarChar(200)
  message     String               @db.Text
  severity    AnnouncementSeverity @default(INFO)
  /** Si false, el aviso queda inactivo aunque siga existiendo. */
  isActive    Boolean              @default(true)
  /** Si false, el usuario NO puede descartarlo. */
  dismissible Boolean              @default(true)
  /** Etiqueta opcional de un botón con acción (p. ej. "Recargar"). */
  ctaLabel    String?              @db.VarChar(60)
  /** URL opcional de la acción. "reload://" recarga la página. */
  ctaUrl      String?              @db.VarChar(500)
  /** Si está fijado, no se descarta automáticamente. */
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy  User                    @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  dismissals AnnouncementDismissal[]

  @@index([isActive, expiresAt])
  @@index([createdAt])
}

/** Registro de descarte por usuario. */
model AnnouncementDismissal {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  dismissedAt    DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}
