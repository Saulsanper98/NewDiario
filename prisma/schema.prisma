generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  OPERATOR
}

enum SharePermission {
  READ
  READ_COMMENT
}

enum LogEntryType {
  INCIDENCIA
  INFORMATIVO
  URGENTE
  MANTENIMIENTO
  SIN_NOVEDADES
}

enum LogEntryStatus {
  DRAFT
  PUBLISHED
}

/** Quién puede votar en una encuesta ligada a una nota de bitácora. */
enum LogEntryPollResponseScope {
  DEPARTMENT_ALL
  SELECTED_USERS
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/**
 * Tipos para eventos del calendario.
 *
 *  • `EVENT`   — genérico (reuniones, recordatorios, etc.).
 *  • `ABSENCE` — ausencia del usuario (vacaciones, baja, etc.).
 *                Sustituye al antiguo `UserUnavailability`. El `subtype`
 *                guarda la categoría concreta ("vacations", "sick", "personal",
 *                "training", "other"). El "color" se decide en el cliente.
 *  • `FOCUS`   — bloque de no-molestar (silencia notificaciones de chat).
 *                Reservado para Fase 3.
 */
enum CalendarEventType {
  EVENT
  ABSENCE
  FOCUS
}

/**
 * Festivo del calendario. Tabla precargada por región. Se proyecta como capa
 * sobre la vista del calendario; no son `CalendarEvent` para no contaminar
 * el espacio del usuario.
 */
model Holiday {
  id          String   @id @default(cuid())
  /** Fecha (mediodía UTC para evitar saltos de TZ). */
  date        DateTime @db.Date
  name        String   @db.VarChar(200)
  /** Código de región: "ES" nacional, "ES-CN" Canarias, etc. */
  region      String   @db.VarChar(10)
  /** Si el festivo solo aplica a una localidad concreta (Las Palmas, etc.). */
  locality    String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  @@unique([date, region, locality])
  @@index([date])
  @@index([region])
}

/**
 * Plantilla reutilizable para crear eventos de calendario rápidamente.
 * Cada departamento tiene su propio catálogo de plantillas.
 */
model CalendarEventTemplate {
  id             String   @id @default(cuid())
  departmentId   String
  authorId       String
  name           String   @db.VarChar(120)
  /** Cuerpo opcional de la plantilla. */
  description    String?  @db.Text
  /** Duración por defecto en minutos (para eventos con hora). */
  defaultDurationMinutes Int @default(60)
  allDay         Boolean  @default(false)
  color          String   @default("blue") @db.VarChar(20)
  /** Si la plantilla incluye una regla de recurrencia por defecto. */
  recurrenceRule String?  @db.Text
  /** Hora de inicio sugerida en formato "HH:mm" (para mostrarla pre-rellenada). */
  defaultStartTime String? @db.VarChar(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  department  Department @relation(fields: [departmentId], references: [id])
  author      User       @relation("CalendarTemplateAuthor", fields: [authorId], references: [id])

  @@index([departmentId])
  @@index([authorId])
  @@index([deletedAt])
}

/**
 * Tipos para la "bitácora lite" de un proyecto.
 *
 *  • PROGRESO  → "hoy he avanzado en X".
 *  • BLOQUEO   → "no puedo avanzar por Y" (genera notificación a todo el equipo).
 *  • DECISION  → "hemos decidido Z" (acuerdos / registro decisional).
 *  • NOTA      → general / observación.
 *
 * Deliberadamente diferente de `LogEntryType` (bitácora del depto), porque las
 * categorías operativas (URGENTE, INCIDENCIA, MANTENIMIENTO…) no aplican a
 * proyectos: aquí lo importante es el estado del trabajo, no la operación.
 */
enum ProjectLogEntryType {
  PROGRESO
  BLOQUEO
  DECISION
  NOTA
}

enum DocType {
  SPEC
  DECISION
  LINK
  FILE
}

enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  ATTACHMENT_ADDED
  SUBTASK_COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  TASK_COMMENTED
  LOG_SHARED
  PROJECT_SHARED
  MENTION
  COMMENT_REPLY
  BUG_REPORT_CLOSED
  CHAT_MESSAGE
  CHAT_RETENTION_WARNING
  PROJECT_LOG_BLOCKED
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum BugReportPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── Users & Departments ─────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?
  image          String?
  /** Posición horizontal del foco del avatar como porcentaje 0–100. */
  imageFocusX    Float?
  /** Posición vertical del foco del avatar como porcentaje 0–100. */
  imageFocusY    Float?
  /** Fecha de cumpleaños (solo día/mes son relevantes — el año es opcional). */
  birthday       DateTime? @db.Date
  profileBanner  String?
  /** Posición horizontal del foco del fondo de perfil como porcentaje 0–100. */
  bannerFocusX   Float?
  /** Posición vertical del foco del fondo de perfil como porcentaje 0–100. */
  bannerFocusY   Float?
  role      Role      @default(OPERATOR)
  /** Solo el propietario puede activarlo; permite a este SuperAdmin asignar / quitar el rol SuperAdmin a otros. */
  canManageSuperAdmins Boolean @default(false)
  isActive  Boolean   @default(true)
  /**
   * Contador de intentos fallidos consecutivos de login. Se incrementa en
   * cada fallo de password y se resetea tras un login exitoso o tras un
   * lockout. Permite el bloqueo persistente (no se evita con `localStorage`).
   */
  failedLoginAttempts Int       @default(0)
  /** Bloqueo temporal por fuerza bruta. Si > now(), authorize devuelve null antes de bcrypt. */
  lockedUntil         DateTime?
  /**
   * Marca de tiempo del ultimo cambio de password. Si el JWT (token.iat) es
   * anterior, refreshTokenUserFromDb lo invalida; asi cerramos sesiones
   * activas cuando se cambia la contrasena (defensa frente a sesiones
   * robadas).
   */
  passwordChangedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments          UserDepartment[]
  logEntries           LogEntry[]
  logComments          LogComment[]
  logReactions         LogReaction[]
  logEditHistory       LogEditHistory[]
  taskComments         TaskComment[]
  projectComments      ProjectComment[]
  assignedTasks        Task[]           @relation("TaskAssignee")
  createdTasks         Task[]           @relation("TaskCreatedBy")
  coResponsibleTasks   Task[]           @relation("TaskCoResponsible")
  projectMemberships   ProjectMember[]
  shiftHandoffsAuthored   ShiftHandoff[]   @relation("ShiftHandoffAuthor")
  shiftHandoffsDismissed  ShiftHandoff[]   @relation("ShiftHandoffDismissedBy")
  logEntryLinksCreated    LogEntryLink[]
  contractNotifyTasks     Task[]           @relation("TaskContractNotify")
  boardSnapshotsAuthored ProjectBoardSnapshot[] @relation("BoardSnapshotAuthor")
  projectDocs          ProjectDoc[]
  projectActivities    ProjectActivity[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  accounts             Account[]
  sessions             Session[]
  logEntryPollsCreated LogEntryPoll[]       @relation("LogPollAuthor")
  logEntryPollInvitees LogEntryPollInvitee[]
  logEntryPollResponses LogEntryPollResponse[]
  bugReports            BugReport[]
  chatParticipants      ChatParticipant[]
  chatMessagesSent      ChatMessage[]       @relation("ChatMessageSender")
  chatMessageReactions  ChatMessageReaction[]
  pushSubscriptions     PushSubscription[]
  userSounds            UserSound[]
  releaseNotesAuthored  ReleaseNote[]         @relation("ReleaseNoteAuthor")
  releaseNoteReads      ReleaseNoteRead[]
  announcementsAuthored Announcement[]        @relation("AnnouncementAuthor")
  announcementDismissals AnnouncementDismissal[]
  projectLogsAuthored   ProjectLogEntry[]    @relation("ProjectLogAuthor")
  projectLogComments    ProjectLogComment[]  @relation("ProjectLogCommentAuthor")
  projectLogReactions   ProjectLogReaction[] @relation("ProjectLogReactionUser")
  projectLogReads       ProjectLogRead[]     @relation("ProjectLogReadUser")
  calendarEvents        CalendarEvent[]      @relation("CalendarEventAuthor")
  calendarTemplates     CalendarEventTemplate[] @relation("CalendarTemplateAuthor")

  /**
   * Preferencias de sonido del usuario. Mapa categoría -> identificador del
   * sonido a usar. El identificador tiene formato:
   *   - "preset:<id>"  para usar uno de los presets sintéticos
   *   - "user:<userSoundId>" para usar uno subido o importado
   *   - "default" para usar el sonido por defecto de cada categoría
   *   - "off" para silenciar esa categoría
   *
   * Categorías soportadas: "chat", "mention", "login", "task".
   */
  soundPreferences      Json?

  /**
   * Modo Datawall (kiosko). Cuando es true, la cuenta queda restringida a
   * una sola sección operativa + Configuración (resto del sidebar oculto,
   * rutas fuera de scope redirigidas en el middleware) y Proyectos/Bitácora
   * activan auto-refresh en tiempo real para servir como datawall.
   *
   * Pensado para cuentas tipo "tareas@" que viven en pantallas siempre
   * encendidas y son operadas por una persona humana con su propia cuenta.
   */
  kioskMode             Boolean   @default(false)
  /**
   * Sección operativa visible cuando kioskMode = true. Valores soportados:
   *   - "proyectos"  (default)
   *   - "bitacora"
   * Si kioskMode = false, este campo se ignora.
   */
  kioskSection          String?
  /**
   * Email de otra cuenta vinculada para el switch rápido SIN reintroducir
   * password (modo "cuentas hermanas"). Se asume confianza física en la
   * pantalla. La vinculación debe ser recíproca y se valida en el endpoint
   * /api/account-switch: el destino tiene que apuntar de vuelta al origen.
   */
  linkedAccountEmail    String?

  @@index([email])
  @@index([role])
  @@index([isActive])
}

/**
 * Biblioteca personal de sonidos de cada usuario. Cada entrada apunta a un
 * archivo servido por /api/media/<file> (subido desde el PC) o descargado
 * desde una URL externa por el servidor para que la reproducción sea
 * siempre fiable y no dependa de un host externo en el futuro.
 */
model UserSound {
  id           String         @id @default(cuid())
  userId       String
  /** Nombre legible mostrado al usuario en su biblioteca. */
  name         String
  /** URL local servida por /api/media/<storedName>. */
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  source       UserSoundSource @default(UPLOAD)
  /** Si vino de una URL externa, conservamos la original como referencia. */
  originalUrl  String?
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserSoundSource {
  UPLOAD
  URL
}

/**
 * Suscripcion de Web Push (RFC 8030 / VAPID) de un dispositivo / navegador del
 * usuario. Cada `endpoint` es unico a nivel global; el mismo usuario puede
 * tener varios (movil, escritorio, otros navegadores). Cuando un endpoint
 * deja de ser valido (HTTP 404/410), lo borramos.
 */
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  accentColor String   @default("#FFEB66")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        UserDepartment[]
  logEntries     LogEntry[]
  logShares      LogShare[]       @relation("SharedWithDepartment")
  projects       Project[]
  projectShares  ProjectShare[]   @relation("ProjectSharedWith")
  shiftHandoffs  ShiftHandoff[]
  calendarEvents    CalendarEvent[]
  calendarTemplates CalendarEventTemplate[]

  @@index([slug])
}

model UserDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  role         Role     @default(OPERATOR)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Log / Bitácora ───────────────────────────────────────────────────────────

model LogEntry {
  id               String         @id @default(cuid())
  title            String
  content          String         @db.Text
  type             LogEntryType   @default(INFORMATIVO)
  status           LogEntryStatus @default(DRAFT)
  shift            Shift
  requiresFollowup Boolean        @default(false)
  followupDone     Boolean        @default(false)
  /** Ancla narrativa opcional (KPI / umbral) para informes y contexto. */
  metricAnchorLabel  String?        @db.VarChar(160)
  metricAnchorValue  String?        @db.VarChar(120)
  metricAnchorTrend  String?        @db.VarChar(16)
  authorId         String
  departmentId     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  author      User             @relation(fields: [authorId], references: [id])
  department  Department       @relation(fields: [departmentId], references: [id])
  comments    LogComment[]
  attachments LogAttachment[]
  tags        LogTag[]
  shares           LogShare[]
  reactions        LogReaction[]
  tasks            Task[]           @relation("TaskLinkedLog")
  editHistory      LogEditHistory[]
  outgoingLogLinks LogEntryLink[]   @relation("LogLinkFrom")
  incomingLogLinks LogEntryLink[]   @relation("LogLinkTo")
  polls            LogEntryPoll[]
  elevatedFromProjectLogs ProjectLogEntry[] @relation("ProjectLogElevated")

  @@index([authorId])
  @@index([departmentId])
  @@index([status])
  @@index([type])
  @@index([shift])
  @@index([createdAt])
  @@index([requiresFollowup])
  @@index([deletedAt])
  @@index([title])
}

model LogEditHistory {
  id         String   @id @default(cuid())
  logEntryId String
  editedById String
  changes    String   @db.Text
  createdAt  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  editedBy User     @relation(fields: [editedById], references: [id])

  @@index([logEntryId])
}

model LogComment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  logEntryId String
  authorId   String
  /// Comentario padre (self-relation). Null = comentario raíz. Cuando el
  /// padre se borra soft-delete, conservamos parentId para renderizar
  /// "Comentario eliminado" como placeholder (tombstone). onDelete:
  /// SetNull cubre el caso (raro) de borrado hard.
  parentId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  logEntry LogEntry      @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id])
  parent   LogComment?   @relation("LogCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  LogComment[]  @relation("LogCommentReplies")

  @@index([logEntryId])
  @@index([authorId])
  @@index([parentId])
}

model LogEntryPoll {
  id              String                   @id @default(cuid())
  logEntryId      String
  question        String                   @db.VarChar(500)
  allowMultiple   Boolean                  @default(false)
  responseScope   LogEntryPollResponseScope
  createdById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  closedAt        DateTime?

  logEntry  LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  createdBy User     @relation("LogPollAuthor", fields: [createdById], references: [id])
  options   LogEntryPollOption[]
  invitees  LogEntryPollInvitee[]
  responses LogEntryPollResponse[]

  @@index([logEntryId])
  @@index([createdById])
}

model LogEntryPollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String @db.VarChar(280)
  sortOrder Int    @default(0)

  poll      LogEntryPoll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses LogEntryPollResponse[]

  @@index([pollId])
}

model LogEntryPollInvitee {
  pollId String
  userId String

  poll LogEntryPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

model LogEntryPollResponse {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   LogEntryPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option LogEntryPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId, userId])
  @@index([optionId])
}

model LogAttachment {
  id         String   @id @default(cuid())
  filename   String
  url        String
  mimeType   String
  size       Int
  logEntryId String
  createdAt  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId])
}

model LogTag {
  id         String @id @default(cuid())
  name       String
  logEntryId String

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId])
  @@index([name])
}

model LogShare {
  id           String          @id @default(cuid())
  logEntryId   String
  departmentId String
  permission   SharePermission @default(READ)
  createdAt    DateTime        @default(now())

  logEntry   LogEntry   @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  department Department @relation("SharedWithDepartment", fields: [departmentId], references: [id])

  @@unique([logEntryId, departmentId])
  @@index([logEntryId])
  @@index([departmentId])
}

/** Reacciones de usuarios a entradas de bitácora (emoji compartido entre todos). */
model LogReaction {
  id         String   @id @default(cuid())
  logEntryId String
  userId     String
  emoji      String   @db.VarChar(8)
  createdAt  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([logEntryId, userId, emoji])
  @@index([logEntryId])
  @@index([userId])
}

/** Notas breves para el siguiente turno (semilla de continuidad). */
model ShiftHandoff {
  id            String    @id @default(cuid())
  departmentId  String
  authorId      String
  shift         Shift
  pendingText   String    @db.Text
  watchText     String    @db.Text
  avoidText     String    @db.Text
  createdAt     DateTime  @default(now())
  dismissedAt   DateTime?
  dismissedById String?

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author      User       @relation("ShiftHandoffAuthor", fields: [authorId], references: [id])
  dismissedBy User?      @relation("ShiftHandoffDismissedBy", fields: [dismissedById], references: [id])

  @@index([departmentId, dismissedAt, createdAt])
}

enum LogEntryLinkType {
  LEADS_TO
}

/** Relación explícita entre entradas (causa → efecto). */
model LogEntryLink {
  id          String           @id @default(cuid())
  fromLogId   String
  toLogId     String
  linkType    LogEntryLinkType @default(LEADS_TO)
  createdById String
  createdAt   DateTime         @default(now())

  fromLog   LogEntry @relation("LogLinkFrom", fields: [fromLogId], references: [id], onDelete: Cascade)
  toLog     LogEntry @relation("LogLinkTo", fields: [toLogId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([fromLogId, toLogId, linkType])
  @@index([fromLogId])
  @@index([toLogId])
}

// ─── Projects & Tasks ─────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  status       ProjectStatus @default(ACTIVE)
  priority     Priority      @default(MEDIUM)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  department    Department         @relation(fields: [departmentId], references: [id])
  parent        Project?           @relation("ProjectSubprojects", fields: [parentId], references: [id])
  subprojects   Project[]          @relation("ProjectSubprojects")
  members       ProjectMember[]
  shares        ProjectShare[]
  tasks         Task[]
  kanbanColumns KanbanColumn[]
  attachments   ProjectAttachment[]
  links         ProjectLink[]
  tags          ProjectTag[]
  comments      ProjectComment[]
  activityFeed   ProjectActivity[]
  boardSnapshots ProjectBoardSnapshot[]
  docs           ProjectDoc[]
  logs           ProjectLogEntry[]
  logReads       ProjectLogRead[]

  @@index([departmentId])
  @@index([status])
  @@index([parentId])
  @@index([deletedAt])
  @@index([name])
}

model ProjectBoardSnapshot {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  label     String?
  snapshot  String   @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("BoardSnapshotAuthor", fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectShare {
  id           String          @id @default(cuid())
  projectId    String
  departmentId String
  permission   SharePermission @default(READ)
  createdAt    DateTime        @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation("ProjectSharedWith", fields: [departmentId], references: [id])

  @@unique([projectId, departmentId])
  @@index([projectId])
  @@index([departmentId])
}

model ProjectAttachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTag {
