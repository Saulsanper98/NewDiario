generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  OPERATOR
}

enum SharePermission {
  READ
  READ_COMMENT
}

enum LogEntryType {
  INCIDENCIA
  INFORMATIVO
  URGENTE
  MANTENIMIENTO
  SIN_NOVEDADES
}

enum LogEntryStatus {
  DRAFT
  PUBLISHED
}

/** Quién puede votar en una encuesta ligada a una nota de bitácora. */
enum LogEntryPollResponseScope {
  DEPARTMENT_ALL
  SELECTED_USERS
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DocType {
  SPEC
  DECISION
  LINK
  FILE
}

enum TaskActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  ATTACHMENT_ADDED
  SUBTASK_COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  TASK_COMMENTED
  LOG_SHARED
  PROJECT_SHARED
  MENTION
  BUG_REPORT_CLOSED
  CHAT_MESSAGE
}

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum BugReportPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── Users & Departments ─────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?
  image          String?
  /** Posición horizontal del foco del avatar como porcentaje 0–100. */
  imageFocusX    Float?
  /** Posición vertical del foco del avatar como porcentaje 0–100. */
  imageFocusY    Float?
  profileBanner  String?
  /** Posición horizontal del foco del fondo de perfil como porcentaje 0–100. */
  bannerFocusX   Float?
  /** Posición vertical del foco del fondo de perfil como porcentaje 0–100. */
  bannerFocusY   Float?
  role      Role      @default(OPERATOR)
  /** Solo el propietario puede activarlo; permite a este SuperAdmin asignar / quitar el rol SuperAdmin a otros. */
  canManageSuperAdmins Boolean @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments          UserDepartment[]
  logEntries           LogEntry[]
  logComments          LogComment[]
  logReactions         LogReaction[]
  logEditHistory       LogEditHistory[]
  taskComments         TaskComment[]
  projectComments      ProjectComment[]
  assignedTasks        Task[]           @relation("TaskAssignee")
  createdTasks         Task[]           @relation("TaskCreatedBy")
  coResponsibleTasks   Task[]           @relation("TaskCoResponsible")
  projectMemberships   ProjectMember[]
  shiftHandoffsAuthored   ShiftHandoff[]   @relation("ShiftHandoffAuthor")
  shiftHandoffsDismissed  ShiftHandoff[]   @relation("ShiftHandoffDismissedBy")
  logEntryLinksCreated    LogEntryLink[]
  contractNotifyTasks     Task[]           @relation("TaskContractNotify")
  boardSnapshotsAuthored ProjectBoardSnapshot[] @relation("BoardSnapshotAuthor")
  projectDocs          ProjectDoc[]
  projectActivities    ProjectActivity[]
  unavailabilities     UserUnavailability[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  accounts             Account[]
  sessions             Session[]
  logEntryPollsCreated LogEntryPoll[]       @relation("LogPollAuthor")
  logEntryPollInvitees LogEntryPollInvitee[]
  logEntryPollResponses LogEntryPollResponse[]
  bugReports            BugReport[]
  chatParticipants      ChatParticipant[]
  chatMessagesSent      ChatMessage[]       @relation("ChatMessageSender")
  chatMessageReactions  ChatMessageReaction[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  accentColor String   @default("#FFEB66")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        UserDepartment[]
  logEntries     LogEntry[]
  logShares      LogShare[]       @relation("SharedWithDepartment")
  projects       Project[]
  projectShares  ProjectShare[]   @relation("ProjectSharedWith")
  shiftHandoffs  ShiftHandoff[]

  @@index([slug])
}

model UserDepartment {
  id           String   @id @default(cuid())
  userId       String
  departmentId String
  role         Role     @default(OPERATOR)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
}

/** Bloques donde el usuario no debe recibir asignaciones críticas (despacho / ventana de cambio). */
model UserUnavailability {
  id        String   @id @default(cuid())
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  label     String?  @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt, endsAt])
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Log / Bitácora ───────────────────────────────────────────────────────────

model LogEntry {
  id               String         @id @default(cuid())
  title            String
  content          String         @db.Text
  type             LogEntryType   @default(INFORMATIVO)
  status           LogEntryStatus @default(DRAFT)
  shift            Shift
  requiresFollowup Boolean        @default(false)
  followupDone     Boolean        @default(false)
  /** Ancla narrativa opcional (KPI / umbral) para informes y contexto. */
  metricAnchorLabel  String?        @db.VarChar(160)
  metricAnchorValue  String?        @db.VarChar(120)
  metricAnchorTrend  String?        @db.VarChar(16)
  authorId         String
  departmentId     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  author      User             @relation(fields: [authorId], references: [id])
  department  Department       @relation(fields: [departmentId], references: [id])
  comments    LogComment[]
  attachments LogAttachment[]
  tags        LogTag[]
  shares           LogShare[]
  reactions        LogReaction[]
  tasks            Task[]           @relation("TaskLinkedLog")
  editHistory      LogEditHistory[]
  outgoingLogLinks LogEntryLink[]   @relation("LogLinkFrom")
  incomingLogLinks LogEntryLink[]   @relation("LogLinkTo")
  polls            LogEntryPoll[]

  @@index([authorId])
  @@index([departmentId])
  @@index([status])
  @@index([type])
  @@index([shift])
  @@index([createdAt])
  @@index([requiresFollowup])
  @@index([deletedAt])
  @@index([title])
}

model LogEditHistory {
  id         String   @id @default(cuid())
  logEntryId String
  editedById String
  changes    String   @db.Text
  createdAt  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  editedBy User     @relation(fields: [editedById], references: [id])

  @@index([logEntryId])
}

model LogComment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  logEntryId String
  authorId   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([logEntryId])
  @@index([authorId])
}

model LogEntryPoll {
  id              String                   @id @default(cuid())
  logEntryId      String
  question        String                   @db.VarChar(500)
  allowMultiple   Boolean                  @default(false)
  responseScope   LogEntryPollResponseScope
  createdById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  closedAt        DateTime?

  logEntry  LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  createdBy User     @relation("LogPollAuthor", fields: [createdById], references: [id])
  options   LogEntryPollOption[]
  invitees  LogEntryPollInvitee[]
  responses LogEntryPollResponse[]

  @@index([logEntryId])
  @@index([createdById])
}

model LogEntryPollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String @db.VarChar(280)
  sortOrder Int    @default(0)

  poll      LogEntryPoll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses LogEntryPollResponse[]

  @@index([pollId])
}

model LogEntryPollInvitee {
  pollId String
  userId String

  poll LogEntryPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

model LogEntryPollResponse {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   LogEntryPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option LogEntryPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId, userId])
  @@index([optionId])
}

model LogAttachment {
  id         String   @id @default(cuid())
  filename   String
  url        String
  mimeType   String
  size       Int
  logEntryId String
  createdAt  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId])
}

model LogTag {
  id         String @id @default(cuid())
  name       String
  logEntryId String

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)

  @@index([logEntryId])
  @@index([name])
}

model LogShare {
  id           String          @id @default(cuid())
  logEntryId   String
  departmentId String
  permission   SharePermission @default(READ)
  createdAt    DateTime        @default(now())

  logEntry   LogEntry   @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  department Department @relation("SharedWithDepartment", fields: [departmentId], references: [id])

  @@unique([logEntryId, departmentId])
  @@index([logEntryId])
  @@index([departmentId])
}

/** Reacciones de usuarios a entradas de bitácora (emoji compartido entre todos). */
model LogReaction {
  id         String   @id @default(cuid())
  logEntryId String
  userId     String
  emoji      String   @db.VarChar(8)
  createdAt  DateTime @default(now())

  logEntry LogEntry @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([logEntryId, userId, emoji])
  @@index([logEntryId])
  @@index([userId])
}

/** Notas breves para el siguiente turno (semilla de continuidad). */
model ShiftHandoff {
  id            String    @id @default(cuid())
  departmentId  String
  authorId      String
  shift         Shift
  pendingText   String    @db.Text
  watchText     String    @db.Text
  avoidText     String    @db.Text
  createdAt     DateTime  @default(now())
  dismissedAt   DateTime?
  dismissedById String?

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author      User       @relation("ShiftHandoffAuthor", fields: [authorId], references: [id])
  dismissedBy User?      @relation("ShiftHandoffDismissedBy", fields: [dismissedById], references: [id])

  @@index([departmentId, dismissedAt, createdAt])
}

enum LogEntryLinkType {
  LEADS_TO
}

/** Relación explícita entre entradas (causa → efecto). */
model LogEntryLink {
  id          String           @id @default(cuid())
  fromLogId   String
  toLogId     String
  linkType    LogEntryLinkType @default(LEADS_TO)
  createdById String
  createdAt   DateTime         @default(now())

  fromLog   LogEntry @relation("LogLinkFrom", fields: [fromLogId], references: [id], onDelete: Cascade)
  toLog     LogEntry @relation("LogLinkTo", fields: [toLogId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([fromLogId, toLogId, linkType])
  @@index([fromLogId])
  @@index([toLogId])
}

// ─── Projects & Tasks ─────────────────────────────────────────────────────────

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  status       ProjectStatus @default(ACTIVE)
  priority     Priority      @default(MEDIUM)
  startDate    DateTime?
  endDate      DateTime?
  departmentId String
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  department    Department         @relation(fields: [departmentId], references: [id])
  parent        Project?           @relation("ProjectSubprojects", fields: [parentId], references: [id])
  subprojects   Project[]          @relation("ProjectSubprojects")
  members       ProjectMember[]
  shares        ProjectShare[]
  tasks         Task[]
  kanbanColumns KanbanColumn[]
  attachments   ProjectAttachment[]
  links         ProjectLink[]
  tags          ProjectTag[]
  comments      ProjectComment[]
  activityFeed   ProjectActivity[]
  boardSnapshots ProjectBoardSnapshot[]
  docs           ProjectDoc[]

  @@index([departmentId])
  @@index([status])
  @@index([parentId])
  @@index([deletedAt])
  @@index([name])
}

model ProjectBoardSnapshot {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  label     String?
  snapshot  String   @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("BoardSnapshotAuthor", fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectShare {
  id           String          @id @default(cuid())
  projectId    String
  departmentId String
  permission   SharePermission @default(READ)
  createdAt    DateTime        @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department Department @relation("ProjectSharedWith", fields: [departmentId], references: [id])

  @@unique([projectId, departmentId])
  @@index([projectId])
  @@index([departmentId])
}

model ProjectAttachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  projectId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTag {
  id        String @id @default(cuid())
  name      String
  projectId String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectComment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  projectId String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([authorId])
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  userId      String?
  action      String?  @db.VarChar(80)
  description String
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model KanbanColumn {
  id        String   @id @default(cuid())
  name      String
  order     Int
  /** Límite WIP (tareas activas por columna). null = sin límite. */
  wipLimit  Int?
  color     String?
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([order])
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?   @db.Text
  priority       Priority  @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?
  isShiftTask    Boolean   @default(false)
  columnId       String
  projectId      String
  assigneeId     String?
  /** Autor de la tarea (nulo para tareas creadas antes de añadir el campo). */
  createdById    String?
  order          Int       @default(0)
  columnEnteredAt DateTime?
  actualHours   Float?
  blockedReason String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  linkedLogEntryId String?

  /** Contrato operativo (opcional): avisar si retraso, notas SLA / impacto */
  contractNotifyUserId String?
  contractSlaNote        String? @db.Text
  contractImpactNote    String? @db.Text

  column         KanbanColumn   @relation(fields: [columnId], references: [id])
  project        Project        @relation(fields: [projectId], references: [id])
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy      User?          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  contractNotifyUser User?      @relation("TaskContractNotify", fields: [contractNotifyUserId], references: [id])
  coResponsibles User[]         @relation("TaskCoResponsible")
  linkedLogEntry LogEntry?      @relation("TaskLinkedLog", fields: [linkedLogEntryId], references: [id])
  subtasks       Subtask[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  activities     TaskActivity[]
  tags           TaskTag[]

  @@index([columnId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([priority])
  @@index([dueDate])
  @@index([isShiftTask])
  @@index([deletedAt])
  @@index([order])
}

model Subtask {
  id         String    @id @default(cuid())
  title      String
  completed  Boolean   @default(false)
  taskId     String
  assigneeId String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id        String    @id @default(cuid())
  content   String    @db.Text
  taskId    String
  authorId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([authorId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  taskId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id          String           @id @default(cuid())
  taskId      String
  userId      String?
  type        TaskActivityType
  description String
  metadata    String?          @db.Text
  createdAt   DateTime         @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([createdAt])
}

model TaskTag {
  id     String @id @default(cuid())
  name   String
  taskId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([name])
}

model ProjectDoc {
  id          String   @id @default(cuid())
  projectId   String
  title       String   @db.VarChar(300)
  content     String?  @db.Text
  type        DocType  @default(SPEC)
  fileUrl     String?  @db.VarChar(1000)
  fileName    String?  @db.VarChar(500)
  fileType    String?  @db.VarChar(100)
  fileSize    Int?
  pinned      Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId])
  @@index([type])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── Chat (mensajes directos entre usuarios) ───────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /** Si true, es un grupo con N participantes y nombre propio. Si false, es 1-a-1. */
  isGroup     Boolean  @default(false)
  /** Nombre del grupo (solo cuando isGroup). */
  title       String?  @db.VarChar(120)
  /** URL opcional del icono del grupo. */
  image       String?  @db.VarChar(1024)
  /** Usuario que creo el grupo / 1-a-1 (informativo). */
  createdById String?

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([updatedAt])
}

model ChatParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  /** El usuario abandono el grupo. Sigue viendo los mensajes anteriores. */
  leftAt         DateTime?
  /** Soft-delete por participante (1-a-1): la conversacion deja de aparecer
      en SU lista, pero los mensajes se conservan para el otro. Si llega un
      mensaje nuevo se vuelve a poner a null para restaurarla. */
  hiddenAt       DateTime?
  /** El usuario silencio las notificaciones del chat. */
  mutedUntil     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

enum ChatAttachmentKind {
  FILE
  IMAGE
  TASK
  PROJECT
  NOTE
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  /** Opcional para soportar mensajes con solo adjuntos. */
  body           String?   @db.VarChar(4000)
  createdAt      DateTime  @default(now())
  /** Marca cuando el autor edito el cuerpo del mensaje. */
  editedAt       DateTime?
  /** Soft-delete: el mensaje se conserva pero se renderiza como "eliminado". */
  deletedAt      DateTime?
  /** Si este mensaje es una respuesta a otro, su id. SetNull si el original
      se elimina del todo (no soft-delete) para no romper referencias. */
  replyToId      String?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  ChatAttachment[]
  reactions    ChatMessageReaction[]
  replyTo      ChatMessage?     @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]    @relation("ChatMessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

/**
 * Reaccion (emoji) de un usuario sobre un mensaje. Un usuario puede poner
 * varias reacciones distintas sobre el mismo mensaje, pero no la misma dos
 * veces.
 */
model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model ChatAttachment {
  id        String             @id @default(cuid())
  messageId String
  kind      ChatAttachmentKind

  // FILE / IMAGE
  fileName  String?            @db.VarChar(255)
  fileUrl   String?            @db.VarChar(2048)
  mimeType  String?            @db.VarChar(120)
  sizeBytes Int?

  // TASK / PROJECT / NOTE
  refId     String?
  refLabel  String?            @db.VarChar(255)
  refMeta   Json?

  createdAt DateTime           @default(now())

  message   ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind, refId])
}

// ─── Bug reports (panel solo administrador de incidencias) ─────────────────────

model BugReport {
  id          String            @id @default(cuid())
  title       String            @db.VarChar(200)
  description String            @db.Text
  pageUrl     String?           @db.VarChar(2048)
  status      BugReportStatus   @default(OPEN)
  priority    BugReportPriority @default(MEDIUM)
  adminNotes  String?           @db.Text
  reporterId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
  @@index([createdAt])
}

// ─── System ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  description String
  metadata    String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
}
