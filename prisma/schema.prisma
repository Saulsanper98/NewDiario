/**
 * Bitácora lite del proyecto.
 *
 * A diferencia de `LogEntry` (bitácora del departamento), aquí no hay turno,
 * métrica, etiquetas ni shares: el contexto es siempre un proyecto y los
 * lectores son siempre sus miembros. El editor del cuerpo es el mismo de la
 * bitácora del departamento (TipTap rich text) por coherencia.
 */
model ProjectLogEntry {
  id        String              @id @default(cuid())
  projectId String
  authorId  String
  type      ProjectLogEntryType @default(NOTA)
  /** Título opcional. Si está vacío, se muestra solo el cuerpo en el feed. */
  title     String?             @db.VarChar(300)
  /** Cuerpo rich text HTML ya sanitizado en la API. */
  content   String              @db.Text
  /** Solo el owner del proyecto puede fijar entradas; aparecen siempre arriba. */
  pinned    Boolean             @default(false)
  /**
   * Si esta entrada se "elevó" a la bitácora del departamento, aquí guardamos
   * el id de la nota creada. La entrada original sigue viva en el proyecto y
   * mostramos un chip enlazando a la nota oficial.
   *
   * `onDelete: SetNull` para que si la nota del depto se borra, la entrada
   * del proyecto sobreviva (queda como si no estuviera elevada).
   */
  elevatedToLogEntryId String?
  elevatedAt           DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  /** Soft delete (igual patrón que LogEntry / Task). */
  deletedAt DateTime?

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author           User                 @relation("ProjectLogAuthor", fields: [authorId], references: [id])
  elevatedToEntry  LogEntry?            @relation("ProjectLogElevated", fields: [elevatedToLogEntryId], references: [id], onDelete: SetNull)
  comments         ProjectLogComment[]
  reactions        ProjectLogReaction[]

  @@index([projectId, createdAt])
  @@index([projectId, pinned])
  @@index([authorId])
  @@index([deletedAt])
  @@index([elevatedToLogEntryId])
}

model ProjectLogComment {
  id                String    @id @default(cuid())
  projectLogEntryId String
  authorId          String
  /// Self-relation para hilos (mismo patrón que LogComment).
  parentId          String?
  content           String    @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  logEntry ProjectLogEntry      @relation(fields: [projectLogEntryId], references: [id], onDelete: Cascade)
  author   User                 @relation("ProjectLogCommentAuthor", fields: [authorId], references: [id])
  parent   ProjectLogComment?   @relation("ProjectLogCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  ProjectLogComment[]  @relation("ProjectLogCommentReplies")

  @@index([projectLogEntryId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

/**
 * Reacción a una entrada de bitácora de proyecto. `@@unique` impide que un
 * usuario añada dos veces el mismo emoji (idempotencia para toggle).
 */
model ProjectLogReaction {
  id                String   @id @default(cuid())
  projectLogEntryId String
  userId            String
  emoji             String   @db.VarChar(16)
  createdAt         DateTime @default(now())

  logEntry ProjectLogEntry @relation(fields: [projectLogEntryId], references: [id], onDelete: Cascade)
  user     User            @relation("ProjectLogReactionUser", fields: [userId], references: [id])

  @@unique([projectLogEntryId, userId, emoji])
  @@index([projectLogEntryId])
  @@index([userId])
}

/**
 * Última vez que un usuario "vio" la bitácora de un proyecto.
 *
 * Sirve para mostrar un badge de "no leído" en la pestaña Bitácora del
 * proyecto. Es un modelo intencionadamente simple (un timestamp por par
 * usuario-proyecto) — no almacenamos qué entradas concretas vio, solo cuándo
 * abrió la tab por última vez. Las entradas creadas después se consideran
 * "no leídas" para ese usuario.
 *
 * Trade-off: si alguien edita una entrada vieja, no la marcamos como nueva.
 * Para el MVP es suficiente; si en el futuro se quiere distinguir
 * por-entrada, se cambia este modelo por uno con `entryId`.
 */
model ProjectLogRead {
  id         String   @id @default(cuid())
  userId     String
  projectId  String
  lastSeenAt DateTime @default(now())

  user    User    @relation("ProjectLogReadUser", fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ─── Calendario ───────────────────────────────────────────────────────────────

/**
 * Evento del calendario del departamento.
 *
 * Diseño MVP:
 *  • Visibilidad: solo departamento (autor + miembros del depto). En el futuro
 *    podríamos añadir `personal`/`shared`/`project` con campos adicionales.
 *  • Recurrencia: regla RFC 5545 (RRULE) en `recurrenceRule`. Si es null, es
 *    un evento único. Para expansión usamos `rrule.js` en el servidor.
 *  • Excepciones: modelo `CalendarEventException` con (eventId, originalDate)
 *    para "saltar este día" o "esa ocurrencia tiene otra hora/título".
 *
 * Las ocurrencias NO se persisten — se calculan en cada request del rango
 * pedido. Es la forma estándar de implementar calendarios escalables.
 */
model CalendarEvent {
  id              String   @id @default(cuid())
  departmentId    String
  authorId        String
  title           String   @db.VarChar(300)
  /** Cuerpo opcional rich-text HTML (mismo sanitizado que bitácora). */
  description     String?  @db.Text
  /**
   * Para eventos puntuales: fecha/hora de inicio de la primera ocurrencia.
   * Para eventos recurrentes: fecha/hora del DTSTART (RFC 5545).
   * Para allDay: medianoche en zona local convertida a UTC.
   */
  startsAt        DateTime
  /** Fin de la ocurrencia (mismo offset que startsAt). */
  endsAt          DateTime
  allDay          Boolean  @default(false)
  location        String?  @db.VarChar(300)
  /** Token de color: "blue", "green", "violet", "red", "amber", "sky", "pink" o "#rrggbb". */
  color           String   @default("blue") @db.VarChar(20)
  type            CalendarEventType @default(EVENT)
  /** Etiqueta secundaria libre (categoría/subtipo). */
  subtype         String?  @db.VarChar(80)
  /**
   * Regla de recurrencia RFC 5545 SIN el prefijo "RRULE:".
   * Ej. "FREQ=DAILY", "FREQ=WEEKLY;BYDAY=MO,WE,FR", "FREQ=MONTHLY;BYDAY=1MO".
   * Si es null, el evento NO se repite.
   */
  recurrenceRule  String?  @db.Text
  /**
   * Fecha tope (exclusive) hasta la que se generan ocurrencias. Si es null y
   * `recurrenceRule` está definido, la serie es indefinida (se trunca por la
   * ventana visible en cada query).
   */
  recurrenceUntil DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  department  Department              @relation(fields: [departmentId], references: [id])
  author      User                    @relation("CalendarEventAuthor", fields: [authorId], references: [id])
  exceptions  CalendarEventException[]

  @@index([departmentId, startsAt])
  @@index([departmentId, endsAt])
  @@index([authorId])
  @@index([deletedAt])
  @@index([recurrenceRule])
}

/**
 * Excepción a una ocurrencia recurrente.
 *
 *  • `skip = true` → la ocurrencia de esa fecha se elimina por completo
 *    (típicamente cuando el usuario borra "solo este día").
 *  • Si hay overrides (startsAt/endsAt/title/description/location) → la
 *    ocurrencia de esa fecha se renderiza con esos valores en lugar de los
 *    del evento padre.
 */
model CalendarEventException {
  id            String   @id @default(cuid())
  eventId       String
  /** Fecha original (DTSTART) de la ocurrencia que se altera. */
  originalDate  DateTime
  skip          Boolean  @default(false)
  overrideStartsAt    DateTime?
  overrideEndsAt      DateTime?
  overrideTitle       String?   @db.VarChar(300)
  overrideDescription String?   @db.Text
  overrideLocation    String?   @db.VarChar(300)

  createdAt     DateTime @default(now())

  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalDate])
  @@index([eventId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ─── Chat (mensajes directos entre usuarios) ───────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /** Si true, es un grupo con N participantes y nombre propio. Si false, es 1-a-1. */
  isGroup     Boolean  @default(false)
  /** Nombre del grupo (solo cuando isGroup). */
  title       String?  @db.VarChar(120)
  /** URL opcional del icono del grupo. */
  image       String?  @db.VarChar(1024)
  /** Usuario que creo el grupo / 1-a-1 (informativo). */
  createdById String?

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([updatedAt])
}

model ChatParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  /** El usuario abandono el grupo. Sigue viendo los mensajes anteriores. */
  leftAt         DateTime?
  /** Soft-delete por participante (1-a-1): la conversacion deja de aparecer
      en SU lista, pero los mensajes se conservan para el otro. Si llega un
      mensaje nuevo se vuelve a poner a null para restaurarla. */
  hiddenAt       DateTime?
  /** El usuario silencio las notificaciones del chat. Si esta seteado a una
      fecha futura, NO entra en el badge global ni dispara notificaciones,
      pero la conversacion sigue mostrandose en la lista. */
  mutedUntil     DateTime?
  /** Conversacion fijada para este usuario (aparece en seccion "Fijados"
      arriba del todo, ordenada por pinnedAt desc). */
  pinnedAt       DateTime?
  /** Conversacion archivada para este usuario (oculta de la lista principal,
      visible en seccion "Archivados" colapsable). */
  archivedAt     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

enum ChatAttachmentKind {
  FILE
  IMAGE
  TASK
  PROJECT
  NOTE
}

// ─── Novedades / Release notes ────────────────────────────────────────────────

enum ReleaseNoteCategory {
  FEATURE
  IMPROVEMENT
  FIX
  ANNOUNCEMENT
  BREAKING
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  /** Opcional para soportar mensajes con solo adjuntos. */
  body           String?   @db.VarChar(4000)
  createdAt      DateTime  @default(now())
  /** Marca cuando el autor edito el cuerpo del mensaje. */
  editedAt       DateTime?
  /** Soft-delete: el mensaje se conserva pero se renderiza como "eliminado". */
  deletedAt      DateTime?
  /** Marca explícita del usuario para evitar el auto-borrado a 72 h. */
  keptAt         DateTime?
  /** Cuándo se notificó al usuario que el mensaje iba a borrarse (para no
      avisar repetidamente). */
  deletionWarnedAt DateTime?
  /** Si este mensaje es una respuesta a otro, su id. SetNull si el original
      se elimina del todo (no soft-delete) para no romper referencias. */
  replyToId      String?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  ChatAttachment[]
  reactions    ChatMessageReaction[]
  replyTo      ChatMessage?     @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]    @relation("ChatMessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([createdAt, keptAt])
}

/**
 * Reaccion (emoji) de un usuario sobre un mensaje. Un usuario puede poner
 * varias reacciones distintas sobre el mismo mensaje, pero no la misma dos
 * veces.
 */
model ChatMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model ChatAttachment {
  id        String             @id @default(cuid())
  messageId String
  kind      ChatAttachmentKind

  // FILE / IMAGE
  fileName  String?            @db.VarChar(255)
  fileUrl   String?            @db.VarChar(2048)
  mimeType  String?            @db.VarChar(120)
  sizeBytes Int?

  // TASK / PROJECT / NOTE
  refId     String?
  refLabel  String?            @db.VarChar(255)
  refMeta   Json?

  createdAt DateTime           @default(now())

  message   ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind, refId])
}

// ─── Bug reports (panel solo administrador de incidencias) ─────────────────────

model BugReport {
  id          String            @id @default(cuid())
  title       String            @db.VarChar(200)
  description String            @db.Text
  pageUrl     String?           @db.VarChar(2048)
  status      BugReportStatus   @default(OPEN)
  priority    BugReportPriority @default(MEDIUM)
  adminNotes  String?           @db.Text
  reporterId  String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
  @@index([createdAt])
}

// ─── System ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  description String
  metadata    String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSettings {
